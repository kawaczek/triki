Options -Indexes

# HTML — zawsze świeże
<FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# Assety z ?v= — cache na rok (immutable)
<If "%{QUERY_STRING} =~ /v=/">
  <FilesMatch "\.(js|css|png|svg|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</If>
# Assety bez ?v= (np. gameutils.js importowany przez ES module) — cache 1 godzina
<Else>
  <FilesMatch "\.(js|css|png|svg|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</Else>

# Blokada bezpośredniego dostępu do data/
RewriteEngine On
RewriteRule ^data/ - [F,L]

# Routing API → api.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/.*)?$ api.php [QSA,L]
