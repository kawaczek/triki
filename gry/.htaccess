Options -Indexes

# HTML — zawsze świeże
<FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# Wykryj ?v= w query stringu (cache-busting param)
SetEnvIf QUERY_STRING "v=" HAS_VERSION

# Assety z ?v= — cache na rok (immutable); bez ?v= (np. gameutils.js z ES import) — 1 godzina
<FilesMatch "\.(js|css|png|svg|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable" env=HAS_VERSION
    Header always set Cache-Control "public, max-age=3600" env=!HAS_VERSION
</FilesMatch>

# Blokada bezpośredniego dostępu do data/
RewriteEngine On
RewriteRule ^data/ - [F,L]

# Routing API → api.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/.*)?$ api.php [QSA,L]
